        _showMqDialog = false;
        _bulkMq = false;
    }

    private async Task ConfirmAddMqAsync()
    {
        var config = _mqCandidates.FirstOrDefault(c => c.Guid == _selectedMq);
        if (config is null || _mqTarget is null) return;
        bool alreadyAdded;
        lock (AppState.ProjectTreeLock)
        {
            alreadyAdded = _mqTarget.Children.Any(c => c.MqDetails is not null && c.MqDetails.SN == config.SN);
            if (!alreadyAdded)

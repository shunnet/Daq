    // ================= 组包 / WebApi 设置（对齐 WPF SettingsAutoPack/UpdateAutoPack/RemoveAutoPack + SettingsWebApi 系列，支持感知更新） =================
    private PluginConfigModel? _autoPackTarget;
    private int _autoPackMaxByteLength = 200;
    private string _autoPackFormat = "ABCD";
    private bool _isStringReverseByteWord;

    /// <summary>打开组包设置（已存在 → 修改，不存在 → 新建；弹窗内可移除）</summary>
    private void OpenAutoPack(IProjectTreeViewModel node)
    {
        if (node.DaqDetails is not { } config) return;
        _autoPackTarget = config;
        _autoPackMaxByteLength = config.AutoPack?.MaxByteLength ?? 200;
        _autoPackFormat = (config.AutoPack?.Format ?? DataFormat.ABCD).ToString();
        _isStringReverseByteWord = config.AutoPack?.IsStringReverseByteWord ?? false;
    }

    private void CloseAutoPack() => _autoPackTarget = null;

    private async Task SaveAutoPackAsync()
    {
        var item = _autoPackTarget;
        if (item is null) return;
        _autoPackTarget = null;
        if (!Enum.TryParse<DataFormat>(_autoPackFormat, out var format))
        {
            ToastSvc.Error(T("数据字节序格式不合法"));
            return;
        }
        var previous = item.AutoPack;
        item.AutoPack = new AddressAutoPackModel { MaxByteLength = _autoPackMaxByteLength, Format = format, IsStringReverseByteWord = _isStringReverseByteWord };
        if (!await SavePluginConfigFileAsync())
        {
            item.AutoPack = previous;
            return;
        }
        // 感知更新：项目树引用/插件页同步刷新；运行中设备由 DeviceRuntimeManager 感知后自动重启重订阅（对齐 WPF SetPlugin → RefreshAsync → Retry）
        AppState.NotifyEntityChanged();
        ToastSvc.Success(T("组包设置已保存"));
    }

    private async Task RemoveAutoPackAsync()
    {
        var item = _autoPackTarget;
        if (item is null) return;
        _autoPackTarget = null;
        var previous = item.AutoPack;
        item.AutoPack = null;
        if (!await SavePluginConfigFileAsync())
        {
            item.AutoPack = previous;
            return;
        }
        AppState.NotifyEntityChanged();
        ToastSvc.Success(T("组包已移除"));
    }


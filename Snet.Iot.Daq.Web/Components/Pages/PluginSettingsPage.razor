@page "/plugins/settings"
@rendermode InteractiveServer
@inherits LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using System.Collections.ObjectModel
@using System.Globalization
@using System.IO.Compression
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Snet.Iot.Daq.Core.data
@using Snet.Iot.Daq.Core.handler
@using Snet.Iot.Daq.Web.Components.Shared
@using Snet.Model.data
@using Snet.Utility
@attribute [Authorize(Policy = AuthService.AdminPolicy)]
@inject AppStateService AppState
@inject ToastService Toast
@inject DeviceRuntimeManager RuntimeManager
@inject IJSRuntime JS

<div class="card">
    <div class="card-header">
        <h1 class="card-title"><i class="bi bi-sliders me-2"></i>@T("插件设置")</h1>
        <div class="segmented plugin-tabs">
            <button class="@(_tab == 0 ? "active" : "")" @onclick="() => { _tab = 0; StateHasChanged(); }"><i class="bi bi-box-seam"></i>@T("已装插件")</button>
            <button class="@(_tab == 1 ? "active" : "")" @onclick="() => { _tab = 1; StateHasChanged(); }"><i class="bi bi-gear"></i>@T("插件配置")</button>
        </div>
    </div>

    @if (_tab == 0)
    {
        <div class="toolbar">
            <select class="form-select" style="width:120px" @bind="_uploadType">
                <option value="Daq">Daq</option>
                <option value="Mq">Mq</option>
            </select>
            <button class="btn btn-primary" @onclick="TriggerUploadAsync" disabled="@_uploading">
                <i class="bi bi-cloud-arrow-up"></i>@(_uploading ? @T("上传中...") : @T("上传插件"))
            </button>
            <InputFile OnChange="@OnUploadAsync" accept=".zip" multiple="false" disabled="@_uploading"
                       class="upload-input-hidden" />
            <span class="spacer"></span>
            <button class="btn" @onclick="RefreshPluginList"><i class="bi bi-arrow-clockwise"></i>@T("刷新")</button>
        </div>
        @if (_uploadStatus is not null)
        {
            <div class="upload-status @(_uploadStatus.IsError ? "error" : "success")">@_uploadStatus.Message</div>
        }

        @if (_plugins.Count == 0)
        {
            <Empty Text="@T("暂无已安装插件。可在插件浏览页下载（自动安装）或在此上传 .zip 包")" />
        }
        else
        {
            <div class="item-cards">
                @foreach (var item in _plugins)
                {
                    <div class="item-card">
                        <div class="item-head">
                            <span class="tag @(item.Type == PluginType.Daq ? "tag-primary" : "tag-success")">@item.Type</span>
                            <span class="item-name cfg-item-name">@item.Name</span>
                            <span class="tag">v@(item.Version)</span>
                            <span class="item-time-tip">
                                <span class="tip-text">@T("添加时间")：@item.Time.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </span>
                            <span class="spacer"></span>
                            <span class="tree-actions">
                                <span class="tree-actions-expand @(IsPluginActionsOpen(item) ? "open" : "")">
                                    <button class="btn btn-sm btn-primary" @onclick="() => AddConfigForPluginAsync(item)"><i class="bi bi-plus-circle"></i>@T("添加配置")</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => RemovePluginAsync(item)"><i class="bi bi-trash"></i>@T("移除")</button>
                                </span>
                                <button class="btn btn-icon tree-actions-toggle" @onclick:stopPropagation @onclick="() => TogglePluginActions(item)" title="@T("操作")">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                        <circle cx="5" cy="12" r="1.6" fill="currentColor" />
                                        <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                                        <circle cx="19" cy="12" r="1.6" fill="currentColor" />
                                    </svg>
                                </button>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="toolbar">
            <span class="spacer"></span>
            <button class="btn btn-primary" @onclick="VerifyStatusAsync" disabled="@_verifying">
                <i class="bi bi-check2-circle"></i>@(_verifying ? T("验证中...") : T("状态验证"))
            </button>
        </div>

        @if (AppState.PluginDict.Count == 0)
        {
            <Empty Text="@T("暂无插件配置")" />
        }
        else
        {
            <div class="item-cards">
                @foreach (var item in AppState.PluginDict.Values.OrderBy(p => p.Index))
                {
                    <div class="item-card">
                        <div class="item-head">
                            <span class="tag @(item.Status ? "tag-success" : "tag-danger")">@(item.Status ? T("正常") : T("异常"))</span>
                            <span class="tag @(item.Type == PluginType.Daq ? "tag-primary" : "tag-success")">@item.Type</span>
                            <span class="item-name cfg-item-name">@item.Name</span>
                            <span class="tag mono" title="@item.SN">@item.GetObjSn()</span>
                            <span class="item-time-tip">
                                <span class="tip-text">@T("更新时间")：@item.Time.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </span>
                            <span class="spacer"></span>
                            <span class="tree-actions">
                                <span class="tree-actions-expand @(IsConfigActionsOpen(item) ? "open" : "")">
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditConfigAsync(item)"><i class="bi bi-pencil"></i>@T("修改")</button>
                                    @if (item.Type == PluginType.Daq)
                                    {
                                        <button class="btn btn-sm" @onclick="@(() => OpenDaqTest(item, "read"))"><i class="bi bi-eye"></i>@T("读取")</button>
                                        <button class="btn btn-sm" @onclick="@(() => OpenDaqTest(item, "write"))"><i class="bi bi-pen"></i>@T("写入")</button>
                                    }
                                    @if (item.Type == PluginType.Mq)
                                    {
                                        <button class="btn btn-sm" @onclick="() => OpenMqTest(item)"><i class="bi bi-send"></i>@T("生产")</button>
                                    }
                                    @if (item.Type == PluginType.Daq)
                                    {
                                        <button class="btn btn-sm" @onclick="() => OpenAutoPack(item)"><i class="bi bi-boxes"></i>@T("组包")</button>
                                        <button class="btn btn-sm" @onclick="() => OpenWebApi(item)"><i class="bi bi-globe"></i>WebApi</button>
                                    }
                                    <button class="btn btn-sm btn-danger" @onclick="() => RemoveConfigAsync(item)"><i class="bi bi-trash"></i>@T("移除")</button>
                                </span>
                                <button class="btn btn-icon tree-actions-toggle" @onclick:stopPropagation @onclick="() => ToggleConfigActions(item)" title="@T("操作")">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                        <circle cx="5" cy="12" r="1.6" fill="currentColor" />
                                        <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                                        <circle cx="19" cy="12" r="1.6" fill="currentColor" />
                                    </svg>
                                </button>
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@if (_configEditing)
{
    <ModalDialog Title="@(_editingConfig is null ? T("添加插件配置") : T("修改插件配置"))"
                 TitleIcon="@(_editingConfig is null ? "bi-plus-circle" : "bi-pencil-square")" OnClose="CloseConfigDialog">
        <div class="config-summary">
            <span class="config-summary-item"><i class="bi bi-tag"></i><span class="config-summary-label">@T("类型")</span><span class="config-summary-value">@_newConfigType</span></span>
            <span class="config-summary-item"><i class="bi bi-puzzle"></i><span class="config-summary-label">@T("插件")</span><span class="config-summary-value">@_newConfigPluginName</span></span>
            @if (_protocolField is not null)
            {
                <span class="config-summary-item" title="@_protocolField.DetailsTips">
                    <i class="bi bi-diagram-3"></i>
                    <span class="config-summary-label">@_protocolField.Description</span>
                    @if (_editingConfig is null)
                    {
                        // 添加：协议类型可选择
                        <select class="config-summary-select" value="@_protocolType" @onchange="OnProtocolChange">
                            @foreach (var o in _protocolField.Options)
                            {
                                <option value="@o.Key">@o.Key</option>
                            }
                        </select>
                    }
                    else
                    {
                        // 修改：协议类型只读展示（已确定的配置不允许切换）
                        <span class="config-summary-value">@_protocolType</span>
                    }
                </span>
            }
        </div>
        <div class="param-card">
            <div class="param-card-header">
                <div class="param-card-title"><i class="bi bi-sliders"></i>@T("参数")</div>
                <div class="segmented">
                    <button class="@(_paramTab == "form" ? "active" : "")" @onclick="ShowParamForm"><i class="bi bi-input-cursor-text"></i>@T("表单")</button>
                    <button class="@(_paramTab == "json" ? "active" : "")" @onclick="ShowParamJson"><i class="bi bi-braces"></i>@T("JSON")</button>
                </div>
            </div>
            <div class="param-card-body">
                @if (_loadingParam)
                {
                    <div class="upload-status">@T("正在加载插件默认参数...")</div>
                }
                @if (_paramTab == "form")
                {
                    <div class="param-form">
                        @if (_paramFields.Count == 0)
                        {
                            <div class="param-empty">@T("未获取到参数定义，可切换到 JSON 视图编辑")</div>
                        }
                        @foreach (var f in _paramFields)
                        {
                            <div class="param-row">
                                    <label class="param-label" title="@f.DetailsTips">@f.Description</label>
                                    @if (f.Cate is "select" or "radio")
                                    {
                                        <select class="param-input" @bind="f.Value" @bind:event="onchange" @bind:after="() => OnFieldChanged(f)">
                                            @foreach (var o in f.Options)
                                            {
                                                <option value="@o.Value">@o.Key</option>
                                            }
                                        </select>
                                    }
                                    else if (f.Cate == "unmber")
                                    {
                                        <input class="param-input" type="number" step="any" @bind="f.Value" @bind:event="oninput" @bind:after="() => OnFieldChanged(f)" />
                                    }
                                    else
                                    {
                                        <input class="param-input" @bind="f.Value" @bind:event="oninput" @bind:after="() => OnFieldChanged(f)" />
                                    }
                                    @if (f.Error is not null)
                                    {
                                        <div class="param-error-inline">@f.Error</div>
                                    }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <textarea value="@_configParam" @oninput="OnJsonInput" rows="10" class="mono param-json" placeholder="{ }"></textarea>
                    @if (_paramJsonError is not null)
                    {
                        <div class="param-error">@_paramJsonError</div>
                    }
                }
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn" @onclick="CloseConfigDialog"><i class="bi bi-x-lg"></i>@T("取消")</button>
            <button class="btn btn-primary" @onclick="SaveConfigAsync"><i class="bi bi-check-lg"></i>@T("保存")</button>
        </div>
    </ModalDialog>
}

@if (_mqTestConfig is not null)
{
    <ModalDialog Title="@T("生产测试")" TitleIcon="bi-send" OnClose="CloseMqTest">
        <div class="form-field">
            <label>@T("Topic")</label>
            <input @bind="_mqTestTopic" placeholder="topic/test" />
        </div>
        <div class="form-field">
            <label>@T("内容")</label>
            <textarea @bind="_mqTestContent" rows="3" placeholder="{ }"></textarea>
        </div>
        <div class="modal-footer">
            <button class="btn" @onclick="CloseMqTest"><i class="bi bi-x-lg"></i>@T("取消")</button>
            <button class="btn btn-primary" @onclick="RunMqTestAsync" disabled="@_mqTestRunning">
                <i class="bi bi-play"></i>@(_mqTestRunning ? @T("测试中...") : @T("测试"))
            </button>
        </div>
    </ModalDialog>
}

@if (_daqTestConfig is not null)
{
    <ModalDialog Title="@(_daqTestMode == "read" ? T("读取测试") : T("写入测试"))" TitleIcon="bi-arrow-down-up" OnClose="CloseDaqTest">
        @if (!string.IsNullOrEmpty(_daqTestProtocol))
        {
            <div class="form-field">
                <label>@T("插件")</label>
                <input value="@_daqTestProtocol" disabled />
            </div>
        }
        <div class="form-field">
            <label>@T("地址")</label>
            <input @bind="_daqTestAddress" placeholder="3!40001 / DB5.DBW0" />
        </div>
        <div class="form-field">
            <label>@T("类型")</label>
            <select @bind="_daqTestType">
                @foreach (var name in Enum.GetNames<DataType>())
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label>@T("长度")</label>
            <input type="number" min="1" max="65535" @bind="_daqTestLength" />
        </div>
        <div class="form-field">
            <label>@T("编码")</label>
            <select @bind="_daqTestEncoding">
                @foreach (var name in Enum.GetNames<EncodingType>())
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
        @if (_daqTestMode == "write")
        {
            <div class="form-field">
                <label>@T("值")</label>
                <input @bind="_daqTestValue" placeholder="0" />
            </div>
        }
        <div class="modal-footer">
            <button class="btn" @onclick="CloseDaqTest"><i class="bi bi-x-lg"></i>@T("取消")</button>
            <button class="btn btn-primary" @onclick="RunDaqTestAsync" disabled="@_daqTestRunning">
                <i class="bi bi-play"></i>@(_daqTestRunning ? @T("测试中...") : @T("测试"))
            </button>
        </div>
    </ModalDialog>
}

@if (_testResult is not null)
{
    <ModalDialog Title="@T("测试结果")" TitleIcon="bi-clipboard-check" OnClose="CloseTestResult">
        <div class="form-field">
            <span class="tag @(_testResult.Status ? "tag-success" : "tag-danger")">
                @(_testResult.Status ? T("成功") : T("失败"))
            </span>
        </div>
        <div class="form-field">
            <label>@T("消息")</label>
            <div class="mono result-message">@_testResult.Message</div>
        </div>
        @if (!string.IsNullOrEmpty(_testResult.Data))
        {
            <div class="form-field">
                <label>@T("数据")</label>
                <pre class="mono">@_testResult.Data</pre>
            </div>
        }
        <div class="modal-footer">
            <button class="btn btn-primary" @onclick="CloseTestResult"><i class="bi bi-check-lg"></i>@T("关闭")</button>
</div>
    </ModalDialog>
}

@if (_confirmRemove && _removingPlugin is not null)
{
    <ConfirmDialog Title="@T("温馨提示")"
                   Message="@(_removingSharedCount > 0
                       ? string.Format(T("确认移除插件 {0}？该插件包内还有 {1} 个插件将一并移除"), _removingPlugin.Name, _removingSharedCount)
                       : string.Format(T("确认移除插件 {0}？"), _removingPlugin.Name))"
                   ConfirmText="@T("移除")" CancelText="@T("取消")"
                   OnCancel="() => _confirmRemove = false" OnConfirm="@ConfirmRemoveAsync" />
}

@if (_confirmHotUpdate)
{
    <ConfirmDialog Title="@T("温馨提示")" Message="@T("同名插件已存在，是否执行热更新？运行中的设备将暂停后恢复")" ConfirmText="@T("确定")" CancelText="@T("取消")"
                   OnCancel="CancelHotUpdate" OnConfirm="@ConfirmHotUpdateAsync" />
}

@if (_autoPackConfig is not null)
{
    <ModalDialog Title="@T("组包设置")" TitleIcon="bi-boxes" OnClose="CloseAutoPack">
        <div class="form-field">
            <label>@T("单次批量读取的最大字节数")</label>
            <input type="number" @bind="_autoPackMaxByteLength" />
        </div>
        <div class="form-field">
            <label>@T("数据字节序格式")</label>
            <select @bind="_autoPackFormat">
                @foreach (var fmt in Enum.GetNames(typeof(DataFormat)))
                {
                    <option value="@fmt">@fmt</option>
                }
            </select>
        </div>
        <div class="modal-footer">
            @if (_autoPackConfig.AutoPack is not null)
            {
                <button class="btn btn-danger" @onclick="RemoveAutoPackAsync"><i class="bi bi-trash"></i>@T("移除组包")</button>
            }
            <span class="spacer"></span>
            <button class="btn" @onclick="CloseAutoPack"><i class="bi bi-x-lg"></i>@T("取消")</button>
            <button class="btn btn-primary" @onclick="SaveAutoPackAsync"><i class="bi bi-check-lg"></i>@T("保存")</button>
        </div>
    </ModalDialog>
}

@if (_webApiConfig is not null)
{
    <ModalDialog Title="@T("WebApi 设置")" TitleIcon="bi-globe" OnClose="CloseWebApi">
        <div class="form-field">
            <label>@T("Ip 地址")</label>
            <input @bind="_webApiIp" />
        </div>
        <div class="form-field">
            <label>@T("端口")</label>
            <input type="number" @bind="_webApiPort" />
        </div>
        <div class="form-field">
            <label>@T("跨域")</label>
            <input type="checkbox" @bind="_webApiCrossDomain" />
        </div>
        <div class="modal-footer">
            @if (_webApiConfig.WebApi is not null)
            {
                <button class="btn btn-danger" @onclick="RemoveWebApiAsync"><i class="bi bi-trash"></i>@T("移除 WebApi")</button>
            }
            <span class="spacer"></span>
            <button class="btn" @onclick="CloseWebApi"><i class="bi bi-x-lg"></i>@T("取消")</button>
            <button class="btn btn-primary" @onclick="SaveWebApiAsync"><i class="bi bi-check-lg"></i>@T("保存")</button>
        </div>
    </ModalDialog>
}

    <Toast />
@code {
    private int _tab;
    private string _uploadType = "Daq";
    private bool _uploading;
    private bool _verifying;
    private bool _confirmRemove;
    private PluginListModel? _removingPlugin;
    /// <summary>待移除插件同 dll 目录的其他条目数（确认框提示"一并移除"）</summary>
    private int _removingSharedCount;
    private bool _confirmHotUpdate;
    /// <summary>热更新确认挂起状态（临时目录 + 探测结果），确认/取消路径消费</summary>
    private (string TempPath, PluginType Type, string ZipName, List<(PluginModel Model, object? Param)> Probe)? _pendingHotUpdate;
    private List<PluginListModel> _plugins = new();
    private bool _configEditing;
    private PluginConfigModel? _editingConfig;
    /// <summary>编辑保存落盘失败时的回滚快照（旧 SN/参数/时间）</summary>
    private (string Sn, string Param, DateTime Time)? _editRollback;
    private string _newConfigType = "Daq";
    private string _newConfigPluginName = "";
    private string _configParam = "{}";
    private sealed record UploadStatus(string Message, bool IsError);
    private UploadStatus? _uploadStatus;
    private sealed record TestResult(bool Status, string Message, string? Data);
    private TestResult? _testResult;
    /// <summary>组包设置弹窗状态（对齐 WPF SettingsAutoPack/UpdateAutoPack/RemoveAutoPack）</summary>
    private PluginConfigModel? _autoPackConfig;
    private int _autoPackMaxByteLength = 200;
    private string _autoPackFormat = "ABCD";
    /// <summary>WebApi 设置弹窗状态（对齐 WPF SettingsWebApi/UpdateWebApi/RemoveWebApi）</summary>
    private PluginConfigModel? _webApiConfig;
    private string _webApiIp = "";
    private int _webApiPort = 80;
    private bool _webApiCrossDomain;

    private PluginConfigModel? _mqTestConfig;
    private string _mqTestTopic = "";
    private string _mqTestContent = "";
    private bool _mqTestRunning;
    private PluginConfigModel? _daqTestConfig;
    private string _daqTestMode = "read";
    /// <summary>读取/写入测试弹窗显示的协议类型（插件无协议字段时为空，隐藏"插件"行）</summary>
    private string _daqTestProtocol = "";
    private string _daqTestAddress = "";
    private DataType _daqTestType = DataType.Int16;
    private ushort _daqTestLength = 1;
    private EncodingType _daqTestEncoding = EncodingType.UTF8;
    private string _daqTestValue = "";
    private bool _daqTestRunning;
    private bool _loadingParam;

    /// <summary>参数编辑视图：form = GetArgsAsync 动态表单，json = 原始 JSON 文本</summary>
    private void ShowParamForm() { _paramTab = "form"; StateHasChanged(); }
    private void ShowParamJson() { _paramTab = "json"; StateHasChanged(); }
    private string _paramTab = "form";
    private List<ParamField> _paramFields = new();
    private string? _paramJsonError;
    /// <summary>协议类型选择器：参数定义中 select 且选项与 subset 名对应的字段（如 Modbus 的 ProtocolType）</summary>
    private ParamField? _protocolField;
    private string _protocolType = "";
    /// <summary>参数定义缓存：协议切换重建表单字段时复用，避免重复创建插件实例</summary>
    private ParamModel? _paramDef;
    /// <summary>插件自动分配返回的当前协议 subset（GetAutoAllocatingArgsAsync，属性名列表由插件决定）</summary>
    private ParamModel.subsetSimplify? _autoSubset;

    /// <summary>GetArgsAsync 参数定义中的单个可编辑属性（Show 且 Use 的字段渲染为输入框）</summary>
    private sealed class ParamField
    {
        public string PropertyName = "";
        public string Description = "";
        public string Cate = "text";
        public string Value = "";
        public bool MustFillIn;
        public string? DetailsTips;
        public string? Pattern;
        public string? FailTips;
        public List<ParamOption> Options = new();
        public string? Error;
        public string Group = "";
    }

    private sealed class ParamOption
    {
        /// <summary>显示文案（插件定义，如 "Content(内容)"）</summary>
        public string Key = "";
        /// <summary>真实值（插件定义，枚举为底层数值；写入 JSON 用 Value，显示用 Key）</summary>
        public string Value = "";
    }

    protected override async Task OnInitializedAsync()
    {
        _plugins = LoadPluginList();
        _newConfigPluginName = _plugins.FirstOrDefault(p => p.Type.ToString() == _newConfigType)?.Name ?? "";
        MenuCoordinator.Register(CloseMenu);
        await Task.CompletedTask;
    }

    /// <summary>全局互斥回调：其他菜单打开前先收起本页菜单</summary>
    private void CloseMenu()
    {
        if (_pluginActionsOpen.Count > 0 || _configActionsOpen.Count > 0)
        {
            _pluginActionsOpen.Clear();
            _configActionsOpen.Clear();
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>语言切换：参数表单标签（中文用描述/英文用属性名）随语言重建</summary>
    protected override void OnLanguageChangedCore()
    {
        if (_paramDef is null) return;
        _ = RebuildParamLabelsAsync();
    }

    private async Task RebuildParamLabelsAsync()
    {
        await RefreshAutoSubsetAsync();
        BuildParamFields();
        FromJsonToForm();
        await InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        base.Dispose();
        MenuCoordinator.Unregister(CloseMenu);
        // 注销 document 上的外部点击监听（切页后防止残留 handler 清掉新页面监听）
        try { JS.InvokeVoidAsync("snet.outsideClick.unregisterAll"); } catch { }
        if (_jsRef is not null)
        {
            _jsRef.Dispose();
            _jsRef = null;
        }
        // 页面销毁时清理热更新挂起的临时目录（切页放弃上传）
        var pending = _pendingHotUpdate;
        _pendingHotUpdate = null;
        _confirmHotUpdate = false;
        if (pending is { } p && Directory.Exists(p.TempPath))
        {
            try { Directory.Delete(p.TempPath, true); } catch { /* 清理失败不影响主流程 */ }
        }
    }


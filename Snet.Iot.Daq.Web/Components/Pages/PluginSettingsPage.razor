        _mqTestConfig = item;
        _mqTestTopic = "";
        _mqTestContent = "";
        _mqTestRunning = false;
    }

    private void CloseMqTest() => _mqTestConfig = null;

    private void CloseTestResult() => _testResult = null;

    /// <summary>OperateResult.ResultData → 缩进 JSON 文本（失败/不可序列化时回退 ToString）</summary>
    private static string? FormatResultData(object? data)
    {
        if (data is null) return null;
        try
        {
            return System.Text.Json.JsonSerializer.Serialize(data, JsonIndented);
        }
        catch
        {
            return data.ToString();
        }
    }

    private void ShowTestResult(OperateResult r)
        => _testResult = new TestResult(r.Status, string.IsNullOrWhiteSpace(r.Message) ? T("无消息") : r.Message, FormatResultData(r.ResultData));

    private async Task RunMqTestAsync()
    {
        var item = _mqTestConfig;
        if (item is null) return;
        if (string.IsNullOrWhiteSpace(_mqTestTopic))
        {
            Toast.Warning(T("Topic 不能为空"));
            return;
        }
        _mqTestRunning = true;
        try
        {
            var r = await PluginHandlerCore.TestProduceAsync(item, _mqTestTopic, _mqTestContent);
            CloseMqTest();
            ShowTestResult(r);
            if (r.Status) Toast.Success($"{T("生产成功")}: {r.Message}");
            else Toast.Error($"{T("生产失败")}: {r.Message}");
        }
        catch (Exception ex)
        {
            CloseMqTest();
            _testResult = new TestResult(false, ex.Message, null);
            Toast.Error($"{T("测试失败")}: {ex.Message}");
        }
        finally
        {
            _mqTestRunning = false;
        }
    }

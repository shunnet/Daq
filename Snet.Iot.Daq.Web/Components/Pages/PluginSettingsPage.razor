    private List<PluginListModel> LoadPluginList()
    {
        if (!File.Exists(WebPaths.PluginListConfigPath)) return new();
        try
        {
            var list = PluginHandlerCore.GetPluginUIConfig<ObservableCollection<PluginListModel>>(WebPaths.PluginListConfigPath)?.ToList() ?? new();
            // 路径规范化：旧数据目录（data/）迁移或 WPF 互拷后 Path 可能失效，回退到本数据目录 lib/{type}/{原目录名}
            foreach (var p in list)
            {
                var path = p.PluginDetails?.Path;
                if (!string.IsNullOrEmpty(path) && !Directory.Exists(path))
                {
                    var dirName = Path.GetFileName(Path.TrimEndingDirectorySeparator(path));
                    var fallback = Path.Combine(WebPaths.FilePath, p.Type.ToString().ToLower(), dirName);
                    if (Directory.Exists(fallback)) p.PluginDetails.Path = fallback;
                }
            }
            // 加载去重（历史热更新可能遗留同名条目）
            return list.GroupBy(p => p.Name).Select(g => g.Last()).ToList();
        }
        catch
        {
            return new();
        }
    }

    /// <summary>参数 JSON 序列化：中文不转义（UnsafeRelaxedJsonEscaping），UTF-8 原文存储</summary>
    private static readonly System.Text.Json.JsonSerializerOptions JsonIndented = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
    private static readonly System.Text.RegularExpressions.Regex PluginNameRegex = new(@"^[A-Za-z0-9_\-\.]+$");
    private const long MaxExtractBytes = 200L * 1024 * 1024;
    private const int MaxExtractEntries = 5000;

    /// <summary>点击"上传插件"按钮 → 触发隐藏的文件选择框</summary>
    private async Task TriggerUploadAsync()
    {
        _uploadStatus = null;
        await JS.InvokeVoidAsync("snet.clickFileInput");
    }

    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _uploadStatus = new UploadStatus(string.Format(T("正在上传 {0} ..."), file.Name), false);
        if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            _uploadStatus = new UploadStatus(T("仅支持 .zip 插件包"), true);
            Toast.Error(T("仅支持 .zip 插件包"));
            return;
        }
        if (file.Size > 100 * 1024 * 1024)
        {
            _uploadStatus = new UploadStatus(T("插件包超过 100MB 限制"), true);
            Toast.Error(T("插件包超过 100MB 限制"));
            return;
        }
        var type = Enum.Parse<PluginType>(_uploadType);
        var zipName = Path.GetFileNameWithoutExtension(file.Name);
        // 安全：插件名白名单（防 ".." / "." / 空名 等路径穿越），并对齐 NuGet 包名规则
        if (string.IsNullOrEmpty(zipName) || zipName is "." or ".." || !PluginNameRegex.IsMatch(zipName))
        {
            Toast.Error(T("插件包名不合法"));
            return;
        }
        var typePath = Path.Combine(WebPaths.FilePath, _uploadType.ToLower());
        var libPath = Path.Combine(typePath, zipName);
        if (!Path.GetFullPath(libPath).StartsWith(Path.GetFullPath(typePath) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
        {
            Toast.Error(T("插件路径不合法"));
            return;
        }

        _uploading = true;
        var tempPath = Path.Combine(Path.GetTempPath(), "snet-upload-" + Guid.NewGuid().ToString("N"));
        try
        {
            // 1. 先解压到临时目录（ZipSlip 校验 + zip 炸弹防护）
            Directory.CreateDirectory(tempPath);
            await using (var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024))
            {
                var zipPath = Path.Combine(tempPath, "plugin.zip");
                await using (var fs = File.Create(zipPath))
                    await stream.CopyToAsync(fs);
                using var zip = ZipFile.OpenRead(zipPath);
                long totalBytes = 0;
                if (zip.Entries.Count > MaxExtractEntries)
                    throw new InvalidDataException(T("压缩包条目过多"));
                foreach (var entry in zip.Entries)
                {
                    totalBytes += entry.Length;
                    if (totalBytes > MaxExtractBytes)
                        throw new InvalidDataException(T("解压后体积超过限制"));
                    var dest = Path.GetFullPath(Path.Combine(tempPath, entry.FullName));
                    if (!dest.StartsWith(Path.GetFullPath(tempPath), StringComparison.OrdinalIgnoreCase))
                        throw new InvalidDataException("非法的压缩包路径");
                }
                ZipFile.ExtractToDirectory(zipPath, tempPath, true);
            }

            // 2. 在临时目录先 InitPlugin 探测验证，成功后才进入 lib 目录
            var iName = string.Format("Snet.Model.interface.I{0}", type);
            var result = PluginHandlerCore.PluginOperate.InitPlugin(tempPath, iName);
            if (result.Count == 0)
            {
                _uploadStatus = new UploadStatus(T("插件上传失败，未检索到对应接口"), true);
                Toast.Error(T("插件上传失败，未检索到对应接口"));
                return;
            }

            // 3. 验证通过：同名插件执行热更新前需用户确认（对齐 WPF 询问流程）
            if (Directory.Exists(libPath))
            {
                _pendingHotUpdate = (tempPath, type, zipName, result);
                _confirmHotUpdate = true;
                return; // tempPath 与 _uploading 保持，由确认/取消路径收尾
            }

            await InstallUploadedAsync(tempPath, type, zipName, result, hotUpdate: false);
        }
        catch (Exception ex)
        {
            _uploadStatus = new UploadStatus(T("插件上传失败") + ": " + ex.Message, true);
            Toast.Error(T("插件上传失败") + ": " + ex.Message);
        }
        finally
        {
            if (_pendingHotUpdate is null)
            {
                if (Directory.Exists(tempPath))
                {
                    try { Directory.Delete(tempPath, true); } catch { /* 清理失败不影响主流程 */ }
                }
                _uploading = false;
            }
        }
    }

    /// <summary>
    /// 安装已探测验证的插件包：停设备 → 旧目录原子让位 → 新包就位 → 卸载旧程序集/清备份 → 更新清单。
    /// 让位失败立即恢复旧目录；本次停掉的设备在 finally 中恢复（无论清单保存成败）。
    /// </summary>
    private async Task InstallUploadedAsync(string tempPath, PluginType type, string zipName,
        List<(PluginModel Model, object? Param)> result, bool hotUpdate)
    {
        var typePath = Path.Combine(WebPaths.FilePath, type.ToString().ToLower());
        var libPath = Path.Combine(typePath, zipName);
        var stoppedDevices = new List<DeviceRuntime>();
        string? backupPath = null;
        try
        {
            if (hotUpdate)
            {
                stoppedDevices = await StopDevicesUsingPluginAsync(type, zipName);
                // 旧目录先原子让位（同盘 rename）：新包 Move 失败时立即恢复，旧插件不毁
                backupPath = libPath + ".old-" + Guid.NewGuid().ToString("N")[..8];
                Directory.Move(libPath, backupPath);
                try
                {
                    Directory.Move(tempPath, libPath);
                }
                catch
                {
                    Directory.Move(backupPath, libPath); // 恢复旧目录后向上抛
                    backupPath = null;
                    throw;
                }
                Toast.Info(T("同名插件已存在，执行热更新"));
            }
            else
            {
                Directory.Move(tempPath, libPath);
            }

            var names = new List<string>();
            foreach (var (model, _) in result)
            {
                model.Path = libPath;
                // 热更新/重复上传时先移除同名旧列表项，避免重复显示
                _plugins.RemoveAll(p => p.Name == model.Name);
                _plugins.Add(new PluginListModel(model.Name, type, model.Version, DateTime.Now, model));
                names.Add(model.Name);
            }
            await SavePluginListAsync();
            // 与文件强制同步（防内存/文件漂移），并确保列表区渲染
            _plugins = LoadPluginList();
            _tab = 0; // 强制切回"已装插件"Tab，让上传结果立即可见
            _uploadStatus = new UploadStatus(string.Format(T("上传成功：{0}，已安装 {1}，见下方「已安装插件」列表"), zipName + ".zip", string.Join("、", names)), false);
            Toast.Success(string.Format(T("插件上传成功：{0}"), zipName + ".zip"));
            StateHasChanged();

            // 新包就位后卸载旧插件程序集并清理备份（对齐 WPF PrivateRemovalPlugin：卸载 + GC，避免文件锁）
            if (backupPath is not null)
            {
                foreach (var old in _plugins.Where(p => Path.GetFullPath(p.PluginDetails.Path) == Path.GetFullPath(libPath)).ToList())
                {
                    try { PluginHandlerCore.PluginOperate.RemovePluginAsync(old.Name); } catch { /* 未注册/已卸载忽略 */ }
                }
                GC.Collect();
                GC.WaitForPendingFinalizers();
                try { Directory.Delete(backupPath, true); } catch { /* 备份清理失败不影响主流程 */ }
            }
        }
        finally
        {
            // 恢复热更新前正在运行的设备（只恢复本次停掉的，不复活用户手动停止的）
            foreach (var rt in stoppedDevices)
                await rt.CollectAsync();
            // 感知更新：同步设备底层版本号（设备卡展示热更新后的新版本）
            AppState.NotifyEntityChanged();
        }
    }

    private async Task ConfirmHotUpdateAsync()
    {
        var pending = _pendingHotUpdate;
        _confirmHotUpdate = false;
        _pendingHotUpdate = null;
        if (pending is not { } p) return;
        try
        {
            await InstallUploadedAsync(p.TempPath, p.Type, p.ZipName, p.Probe, hotUpdate: true);
        }
        catch (Exception ex)
        {
            _uploadStatus = new UploadStatus(T("插件上传失败") + ": " + ex.Message, true);
            Toast.Error(T("插件上传失败") + ": " + ex.Message);
        }
        finally
        {
            if (Directory.Exists(p.TempPath))
            {
                try { Directory.Delete(p.TempPath, true); } catch { /* 清理失败不影响主流程 */ }
            }
            _uploading = false;
        }
    }

    private void CancelHotUpdate()
    {
        _confirmHotUpdate = false;
        var pending = _pendingHotUpdate;
        _pendingHotUpdate = null;
        if (pending is { } p && Directory.Exists(p.TempPath))
        {
            try { Directory.Delete(p.TempPath, true); } catch { /* 清理失败不影响主流程 */ }
        }
        _uploading = false;
    }

    /// <summary>停用使用该插件的运行设备并返回列表（MQ 插件影响所有转发设备，全部暂停）</summary>
    private async Task<List<DeviceRuntime>> StopDevicesUsingPluginAsync(PluginType type, string pluginName)
    {
        var stopped = new List<DeviceRuntime>();
        foreach (var rt in RuntimeManager.Runtimes)
        {
            var match = type == PluginType.Daq
                ? rt.DeviceType == pluginName
                : rt.IsRun; // MQ 插件与设备关联在地址转发中，简化：全部停止
            if (match && rt.IsRun)
            {
                await rt.StopAsync();
                stopped.Add(rt);
            }
        }
        return stopped;
    }

    /// <summary>保存插件清单（写门串行 + 重试写，对齐 ProjectConfig 落盘方式）。失败抛 IOException（调用方 catch 提示）</summary>
    private async Task SavePluginListAsync()
    {
        Directory.CreateDirectory(WebPaths.UiConfigPath);
        await AppState.ConfigSaveGate.WaitAsync();
        try
        {
            var list = new ObservableCollection<PluginListModel>(_plugins);
            if (!await ProjectHandlerCore.WriteToFileWithRetryAsync(WebPaths.PluginListConfigPath, list.ToJson(true)))
                throw new IOException($"写入失败: {WebPaths.PluginListConfigPath}");
        }
        finally
        {
            AppState.ConfigSaveGate.Release();
        }
    }


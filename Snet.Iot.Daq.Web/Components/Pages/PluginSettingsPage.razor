        return Task.CompletedTask;
    }

    /// <summary>卡片"移除"按钮：记录待移除插件并弹出确认</summary>
    private void RemovePluginAsync(PluginListModel item)
    {
        _removingPlugin = item;
        // 同 dll 目录（PluginDetails.Path 一致）的其他插件条目将一并移除（对齐 WPF PrivateRemovalPlugin）
        _removingSharedCount = Math.Max(0, _plugins.Count(p => SamePluginPath(p.PluginDetails?.Path, item.PluginDetails?.Path)) - 1);
        _confirmRemove = true;
    }

    private async Task ConfirmRemoveAsync()
    {
        var selected = _removingPlugin;
        _confirmRemove = false;
        _removingPlugin = null;
        var sharedCount = _removingSharedCount;
        _removingSharedCount = 0;
        if (selected is null) return;
        await OperateInfoAsync($"移除插件：{selected.Name}");
        var path = selected.PluginDetails?.Path;
        // 同 dll 目录（Path 一致）的全部插件条目（对齐 WPF PrivateRemovalPlugin：删目录后一并清列表，不留幽灵条目）
        var sharedNames = _plugins
            .Where(p => SamePluginPath(p.PluginDetails?.Path, path))
            .Select(p => p.Name)
            .ToList();
        var coreOk = false;
        try
        {
            // 停用相关设备（对齐 WPF 按 Path 停设备：同包内所有插件名的设备都受影响）
            if (selected.Type == PluginType.Daq)
            {
                foreach (var name in sharedNames)
                    await StopDevicesUsingPluginAsync(PluginType.Daq, name);
            }
            else
            {
                await StopDevicesUsingPluginAsync(PluginType.Mq, selected.Name);
            }
            // 传 className（Core 按插件名实时扫描 lib 目录定位），传路径会查不到导致永远失败
            coreOk = await PluginHandlerCore.PluginOperate.RemovePluginAsync(selected.Name);
            if (coreOk && !string.IsNullOrEmpty(path) && Directory.Exists(path))
            {
                try
                {
                    Directory.Delete(path, true);
                }
                catch (Exception ex)
                {
                    Toast.Warning(T("插件目录清理失败") + ": " + ex.Message + "，" + T("重启服务器后可彻底清理"));
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error(T("插件移除失败") + ": " + ex.Message);
        }
        // 无论 Core 调用结果如何，列表与配置文件都要同步（目录可能已删，避免残留幽灵条目）：
        // 同 Path 的其余插件一并移除（对齐 WPF 倒序删除同路径条目）
        var removedCount = _plugins.RemoveAll(p => SamePluginPath(p.PluginDetails?.Path, path));
        try { await SavePluginListAsync(); } catch { /* 文件写失败下次刷新纠正 */ }
        _uploadStatus = new UploadStatus(coreOk
            ? string.Format(T("插件已移除：{0}"), removedCount > 1 ? $"{selected.Name} 等 {removedCount} 个插件" : selected.Name)
            : string.Format(T("插件目录移除失败（列表已清理）：{0}"), selected.Name), !coreOk);
        Toast.Success(coreOk ? T("插件移除成功") : T("插件已从列表移除，目录清理失败"));
        // 感知更新：使用该插件的设备配置可能已失效，刷新项目树引用
        AppState.NotifyEntityChanged();
        StateHasChanged();
    }

    /// <summary>同 dll 目录判定（对齐 WPF PluginDetails.Path 一致即同包），忽略大小写与尾分隔符差异</summary>
    private static bool SamePluginPath(string? a, string? b)
    {
        if (string.IsNullOrEmpty(a) || string.IsNullOrEmpty(b)) return false;
        return string.Equals(
            a.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
            b.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task VerifyStatusAsync()
    {
        _verifying = true;
        try
        {
            var failed = new List<string>();
            foreach (var item in AppState.PluginDict.Values)
            {
                var iName = string.Format("Snet.Model.interface.I{0}", item.Type);
                var result = await PluginHandlerCore.PluginOperate.StatusVerifyAsync(iName, item.Name, item.Param);
                item.Status = result.Status;
                if (!result.Status) failed.Add(item.Name);
            }
            // 状态变化也感知同步（树中设备/MQ 名称包含 SN，状态不影响名称但保持引用一致）
            AppState.NotifyEntityChanged();
            Toast.Success(failed.Count == 0 ? T("状态验证通过") : $"{T("验证完成")}，{failed.Count} 个异常");
        }
        catch (Exception ex)
        {
            Toast.Error(T("状态验证失败") + ": " + ex.Message);
        }
        finally
        {
            _verifying = false;
        }
    }

    /// <summary>从已装插件卡片添加配置：保持当前 tab 打开弹窗（取消/关闭不跳转），保存成功后切到「插件配置」展示新配置</summary>

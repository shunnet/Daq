    private async Task LoadBasicsParamAsync()
    {
        var plugin = _plugins.FirstOrDefault(p => p.Name == _newConfigPluginName && p.Type.ToString() == _newConfigType);
        if (plugin is null) return;
        _loadingParam = true;
        try
        {
            var json = await GetBasicsArgsJsonAsync(plugin.Name, plugin.Type);
            if (!string.IsNullOrEmpty(json))
                _configParam = FormatParam(json);
        }
        catch
        {
            // 加载失败保持现有输入，不打断用户
        }
        finally
        {
            _loadingParam = false;
        }
    }

    /// <summary>创建临时插件实例读取默认基础参数，返回 JSON 文本</summary>
    private static async Task<string?> GetBasicsArgsJsonAsync(string name, PluginType type)
    {
        try
        {
            if (type == PluginType.Daq)
            {
                var d = await PluginHandlerCore.PluginOperate.CreateAsync<IDaq>(name, "{}", PluginType.Daq);
                if (d is null) return null;
                var r = await d.GetBasicsArgsAsync(CancellationToken.None);
                await SafeReleaseInstanceAsync(d);
                return r.Status && r.ResultData is not null
                    ? System.Text.Json.JsonSerializer.Serialize(r.ResultData, JsonIndented)
                    : null;
            }
            var m = await PluginHandlerCore.PluginOperate.CreateAsync<IMq>(name, "{}", PluginType.Mq);
            if (m is null) return null;
            var rm = await m.GetBasicsArgsAsync(CancellationToken.None);
            await SafeReleaseInstanceAsync(m);
            return rm.Status && rm.ResultData is not null
                ? System.Text.Json.JsonSerializer.Serialize(rm.ResultData, JsonIndented)
                : null;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>创建临时插件实例读取参数定义（GetArgsAsync(false) → ParamModel），用于动态渲染表单</summary>
    private static async Task<ParamModel?> GetArgsDefAsync(string name, PluginType type)
    {
        try
        {
            if (type == PluginType.Daq)
            {
                var d = await PluginHandlerCore.PluginOperate.CreateAsync<IDaq>(name, "{}", PluginType.Daq);
                if (d is null) return null;
                var r = await d.GetArgsAsync(false, CancellationToken.None);
                await SafeReleaseInstanceAsync(d);
                return r.Status ? r.ResultData as ParamModel : null;
            }
            var m = await PluginHandlerCore.PluginOperate.CreateAsync<IMq>(name, "{}", PluginType.Mq);
            if (m is null) return null;
            var rm = await m.GetArgsAsync(false, CancellationToken.None);
            await SafeReleaseInstanceAsync(m);
            return rm.Status ? rm.ResultData as ParamModel : null;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>加载参数定义构建表单字段（初值取 Default），并用现有 JSON 回填</summary>
    private async Task LoadParamDefAsync()
    {
        var plugin = _plugins.FirstOrDefault(p => p.Name == _newConfigPluginName && p.Type.ToString() == _newConfigType);
        if (plugin is null)
        {
            _paramDef = null;
            _protocolField = null;
            _autoSubset = null;
            _paramFields = new();
            return;
        }
        try
        {
            // 重置协议状态：插件切换后无协议的插件不应残留上一个插件的协议选择器
            _protocolField = null;
            _autoSubset = null;
            _paramDef = await GetArgsDefAsync(plugin.Name, plugin.Type);
            await RefreshAutoSubsetAsync();
            BuildParamFields();
            FromJsonToForm();
        }
        catch
        {
            _paramDef = null;
            _protocolField = null;
            _autoSubset = null;
            _paramFields = new();
        }
    }

    /// <summary>通过插件自动分配机制（用当前参数 JSON 实例化）获取协议属性名与当前协议 subset；失败时回退 subset 名匹配</summary>
    private async Task RefreshAutoSubsetAsync()
    {
        _autoSubset = null;
        var plugin = _plugins.FirstOrDefault(p => p.Name == _newConfigPluginName && p.Type.ToString() == _newConfigType);
        if (plugin is null || _paramDef is null) return;
        var (propName, subset) = await GetAutoSubsetAsync(plugin.Name, plugin.Type, _configParam);
        if (string.IsNullOrEmpty(propName) || subset is null) return;
        _autoSubset = subset;
        // 协议选择器：字段名取插件声明的自动分配属性名，选项取全量定义的 subset 名
        var desc = _paramDef.Subset.SelectMany(s => s.Propertie)
            .FirstOrDefault(p => p.PropertyName.Equals(propName, StringComparison.OrdinalIgnoreCase))?.Description;
        _protocolField = new ParamField
        {
            PropertyName = propName!,
            // 标签语言自适应：英文界面用属性名，中文界面用插件描述；描述不存在时回退属性名
            Description = Localization.CurrentLanguage == "en" || string.IsNullOrWhiteSpace(desc)
                ? propName!
                : desc,
            Cate = "select",
            Options = _paramDef.Subset.Where(s => !string.IsNullOrEmpty(s.Name)).Select(s => new ParamOption { Key = s.Name!, Value = s.Name! }).ToList()
        };
    }

    /// <summary>创建临时插件实例（传入当前参数 JSON 完成基础数据实例化），
    /// ExistsAutoAllocatingArgsAsync 检测协议属性名，GetAutoAllocatingArgsAsync 返回当前协议 subset 的属性集合</summary>
    private static async Task<(string? PropName, ParamModel.subsetSimplify? Subset)> GetAutoSubsetAsync(
        string name, PluginType type, string paramJson)
    {
        try
        {
            if (type == PluginType.Daq)
            {
                var d = await PluginHandlerCore.PluginOperate.CreateAsync<IDaq>(name, paramJson, PluginType.Daq);
                if (d is null) return (null, null);
                var exists = await d.ExistsAutoAllocatingArgsAsync(CancellationToken.None);
                // ResultData 为 Tuple<Type, string, LibInstanceParam>（Snet.Core 内部类型），反射读 Item2 属性名
                string? propName = null;
                if (exists.Status && exists.ResultData is { } tuple)
                    propName = tuple.GetType().GetProperty("Item2")?.GetValue(tuple)?.ToString();
                ParamModel.subsetSimplify? subset = null;
                if (!string.IsNullOrEmpty(propName))
                {
                    var auto = await d.GetAutoAllocatingArgsAsync(CancellationToken.None);
                    if (auto.Status && auto.ResultData is ParamModel.subsetSimplify ss) subset = ss;
                }
                await SafeReleaseInstanceAsync(d);
                return (propName, subset);
            }
            var m = await PluginHandlerCore.PluginOperate.CreateAsync<IMq>(name, paramJson, PluginType.Mq);
            if (m is null) return (null, null);
            var mexists = await m.ExistsAutoAllocatingArgsAsync(CancellationToken.None);
            string? mpropName = null;
            if (mexists.Status && mexists.ResultData is { } mtuple)
                mpropName = mtuple.GetType().GetProperty("Item2")?.GetValue(mtuple)?.ToString();
            ParamModel.subsetSimplify? msubset = null;
            if (!string.IsNullOrEmpty(mpropName))
            {
                var mauto = await m.GetAutoAllocatingArgsAsync(CancellationToken.None);
                if (mauto.Status && mauto.ResultData is ParamModel.subsetSimplify mss) msubset = mss;
            }
            await SafeReleaseInstanceAsync(m);
            return (mpropName, msubset);
        }
        catch
        {
            return (null, null);
        }
    }

    /// <summary>按当前协议类型从参数定义构建表单字段；无协议字段时全量合并去重</summary>
    private void BuildParamFields()
    {
        var def = _paramDef;
        if (def is null)
        {
            _protocolField = null;
            _paramFields = new();
            return;
        }
        var allProps = def.Subset.SelectMany(s => s.Propertie
            .Where(p => !string.IsNullOrEmpty(p.PropertyName))
            .Select(p => (p, s))).ToList();
        if (_protocolField is not null)
        {
            // 协议初值：JSON 存协议名；历史数据可能存数字，用各 subset 的 ProtocolType.Default 数值映射回协议名
            var jsonProto = ReadJsonText(_protocolField.PropertyName);
            if (!string.IsNullOrEmpty(jsonProto) && _protocolField.Options.Any(o => o.Key.Equals(jsonProto, StringComparison.OrdinalIgnoreCase)))
            {
                _protocolType = jsonProto;
            }
            else
            {
                var byNum = def.Subset
                    .Where(s => !string.IsNullOrEmpty(s.Name))
                    .ToDictionary(s => s.Propertie.FirstOrDefault(p => p.PropertyName.Equals(_protocolField.PropertyName, StringComparison.OrdinalIgnoreCase))?.Default?.ToString() ?? "", s => s.Name!);
                _protocolType = !string.IsNullOrEmpty(jsonProto) && byNum.TryGetValue(jsonProto, out var name)
                    ? name
                    : def.Subset.FirstOrDefault(s => !string.IsNullOrEmpty(s.Name))?.Name ?? "";
            }
            // 当前协议 subset：优先插件自动分配结果（GetAutoAllocatingArgsAsync 按 ProtocolType 值返回，
            // 仅在协议一致时生效），回退 subset 名匹配，再回退全量
            var matched = new List<ParamModel.subset>();
            if (_autoSubset is { Name: { } autoName } && autoName.Equals(_protocolType, StringComparison.OrdinalIgnoreCase))
            {
                var full = def.Subset.FirstOrDefault(s => string.Equals(s.Name, autoName, StringComparison.OrdinalIgnoreCase));
                if (full is not null) matched.Add(full);
            }
            if (matched.Count == 0)
                matched = def.Subset.Where(s => string.Equals(s.Name, _protocolType, StringComparison.OrdinalIgnoreCase)).ToList();
            var source = matched.Count > 0 ? matched : def.Subset;
            // 协议属性本身作为上方独立选择器，不在表单字段中重复显示。
            // SN 为唯一标识符，即使插件参数定义 Show=false 也必须显示（对齐 WPF 属性面板行为）
            _paramFields = source
                .SelectMany(s => s.Propertie
                    .Where(p => !string.IsNullOrEmpty(p.PropertyName)
                                && (p.Show || p.PropertyName.Equals("SN", StringComparison.OrdinalIgnoreCase))
                                && (p.Use || p.PropertyName.Equals("SN", StringComparison.OrdinalIgnoreCase))
                                && !p.PropertyName.Equals(_protocolField.PropertyName, StringComparison.OrdinalIgnoreCase)
                                && !IsMqExcludedField(p.PropertyName))
                    .Select(p => ToParamField(p, s)))
                .GroupBy(f => f.PropertyName)
                .Select(g => g.First())
                .ToList();
        }
        else
        {
            _protocolType = "";
            // 多个 subset 可能重复声明同一属性（重复字段同名覆盖导致表单修改被旧值冲掉），按 PropertyName 去重保留首个。
            // SN 不受 Show/Use 过滤（对齐 WPF 属性面板始终显示唯一标识符）
            _paramFields = allProps
                .Where(x => !string.IsNullOrEmpty(x.p.PropertyName)
                            && (x.p.Show || x.p.PropertyName.Equals("SN", StringComparison.OrdinalIgnoreCase))
                            && (x.p.Use || x.p.PropertyName.Equals("SN", StringComparison.OrdinalIgnoreCase))
                            && !IsMqExcludedField(x.p.PropertyName))
                .Select(x => ToParamField(x.p, x.s))
                .GroupBy(f => f.PropertyName)
                .Select(g => g.First())
                .ToList();
        }
    }

    /// <summary>IMq 表单隐藏字段：Topic 实际不参与传输（MQ 主题取自地址的 Topic，插件配置里的 Topic 用不到）</summary>
    private bool IsMqExcludedField(string propertyName)
        => _newConfigType == PluginType.Mq.ToString()
           && propertyName.Equals("Topic", StringComparison.OrdinalIgnoreCase);

    private ParamField ToParamField(ParamModel.propertie p, ParamModel.subset s)
    {
        var f = new ParamField
        {
            PropertyName = p.PropertyName,
            // 标签语言自适应：中文界面用插件描述，英文界面用属性名
            Description = Localization.CurrentLanguage == "en" || string.IsNullOrWhiteSpace(p.Description)
                ? p.PropertyName
                : p.Description,
            Cate = p.DataCate?.ToString() ?? "text",
            Value = p.Default?.ToString() ?? "",
            MustFillIn = p.MustFillIn,
            DetailsTips = p.DetailsTips,
            Pattern = p.Pattern,
            FailTips = p.FailTips,
            Options = (p.Options ?? new()).Select(o => new ParamOption { Key = o.Key, Value = o.Value?.ToString() ?? o.Key }).ToList(),
            Group = string.IsNullOrWhiteSpace(s.Name) ? "" : s.Name
        };
        // 布尔选项保持按 Key 绑定（下方「是/否」↔ true/false 映射依赖 Key 匹配）
        if (IsBooleanOptions(f))
        {
            foreach (var o in f.Options) o.Value = o.Key;
        }
        // 布尔默认值映射：插件声明 Default=true/false，选项是「是/否」，需映射到选项文案否则下拉框显示空
        if (f.Cate is "select" or "radio" && p.Default is bool b && IsBooleanOptions(f))
            f.Value = b ? f.Options[0].Key : f.Options[1].Key;
        return f;
    }

    /// <summary>协议类型切换：更新 JSON 的协议字段值，用新 JSON 重新获取插件自动分配的 subset，重建表单并回填</summary>
    private async Task OnProtocolChange(ChangeEventArgs e)
    {
        _protocolType = e.Value?.ToString() ?? "";
        if (_protocolField is not null &&
            TryParseJsonObject(_configParam, out var root, out _) && root is JsonObject jo)
        {
            jo[_protocolField.PropertyName] = JsonValue.Create(_protocolType);
            _configParam = jo.ToJsonString(JsonIndented);
        }
        await RefreshAutoSubsetAsync();
        BuildParamFields();
        FromJsonToForm();
    }

    /// <summary>解析参数 JSON（根节点必须是对象），失败时返回带行列位置的错误描述</summary>
    private static bool TryParseJsonObject(string json, out JsonNode? root, out string? error)
    {
        root = null;
        error = null;
        if (string.IsNullOrWhiteSpace(json))
        {
            root = new JsonObject();
            return true;
        }
        try
        {
            root = JsonNode.Parse(json);
            if (root is null || root is JsonObject) return true;
            error = "根节点必须是 JSON 对象 { }";
            return false;
        }
        catch (JsonException ex)
        {
            var line = ex.LineNumber is { } ln ? ln + 1 : 1;
            var col = ex.BytePositionInLine is { } bp ? bp + 1 : 0;
            error = $"第 {line} 行 第 {col} 列：{ex.Message}";
            return false;
        }
    }

    /// <summary>JSON → 表单回填（解析失败只报错，不动表单）</summary>
    private void FromJsonToForm()
    {
        if (!TryParseJsonObject(_configParam, out var root, out var err) || root is not JsonObject jo)
        {
            _paramJsonError = err;
            return;
        }
        _paramJsonError = null;
        // 协议类型联动：JSON 中协议值变化时按新协议重建表单字段
        if (_protocolField is not null)
        {
            var jsonProto = ReadJsonText(_protocolField.PropertyName);
            if (jsonProto is not null && jsonProto != _protocolType)
            {
                _protocolType = jsonProto;
                BuildParamFields();
            }
        }
        foreach (var f in _paramFields)
        {
            var node = jo.FirstOrDefault(p => p.Key.Equals(f.PropertyName, StringComparison.OrdinalIgnoreCase)).Value;
            f.Value = SelectOptionText(f, node);
            f.Error = ValidateField(f);
        }
    }

    /// <summary>JSON 节点 → 控件值。布尔 select（选项为「是/否」或 true/false）按选项顺序映射；其余 select/radio 解析为选项真实值</summary>
    private static string SelectOptionText(ParamField f, JsonNode? node)
    {
        if (f.Cate is "select" or "radio" && node is JsonValue v && v.TryGetValue(out bool b) && IsBooleanOptions(f))
            return b ? f.Options[0].Key : f.Options[1].Key;
        var text = NodeToText(node);
        return f.Cate is "select" or "radio" ? ResolveSelectOption(f, text) : text;
    }

    /// <summary>JSON 文本 → 选项真实值（Value）。
    /// 兼容三种存量格式：数值（枚举底层值）、枚举名（"Content"）、旧表单污染的选项文案（"Content(内容)"）→ 下次保存自动修复</summary>
    private static string ResolveSelectOption(ParamField f, string text)
    {
        foreach (var o in f.Options)
        {
            if (o.Value == text) return o.Value;
            if (o.Key == text) return o.Value;
            // 选项文案格式为 "枚举名(描述)"，JSON 里只存了枚举名
            if (o.Key.StartsWith(text + "(", StringComparison.Ordinal)) return o.Value;
        }
        return text;
    }

    /// <summary>是否为布尔选项集：恰好两项且为「是/否」或 true/false（大小写不敏感）</summary>
    private static bool IsBooleanOptions(ParamField f)
    {
        if (f.Options.Count != 2) return false;
        var a = f.Options[0].Key.ToLowerInvariant();
        var b = f.Options[1].Key.ToLowerInvariant();
        return (a == "是" && b == "否") || (a == "true" && b == "false");
    }

    /// <summary>JSON 节点 → 表单文本（字符串去引号、数字/布尔保原文，嵌套节点按 JSON 文本）</summary>
    private static string NodeToText(JsonNode? node) => node switch
    {
        null => "",
        JsonValue v when v.TryGetValue(out string? s) => s,
        JsonValue v when v.TryGetValue(out bool b) => b ? "true" : "false",
        JsonValue v => v.ToString(),
        _ => node.ToJsonString()
    };

    /// <summary>从当前参数 JSON 顶层按属性名（大小写不敏感）读取文本值</summary>
    private string? ReadJsonText(string propertyName)
    {
        if (TryParseJsonObject(_configParam, out var root, out _) && root is JsonObject jo)
        {
            var node = jo.FirstOrDefault(p => p.Key.Equals(propertyName, StringComparison.OrdinalIgnoreCase)).Value;
            return node is null ? null : NodeToText(node);
        }
        return null;
    }

    /// <summary>表单 → JSON 合并：保留 JSON 中未被表单展示的字段，按字段名更新表单值（数字/布尔保持类型）</summary>
    private void SyncFormToJson()
    {
        if (!TryParseJsonObject(_configParam, out var root, out _) || root is not JsonObject jo)
            jo = new JsonObject();
        foreach (var f in _paramFields)
        {
            var key = jo.FirstOrDefault(p => p.Key.Equals(f.PropertyName, StringComparison.OrdinalIgnoreCase)).Key;
            if (key is null) key = f.PropertyName;
            jo[key] = ParseFieldValue(f);
        }
        // IMq 表单移除 Topic：表单不展示，保存时从 JSON 剔除（历史数据一并清理）
        if (_newConfigType == PluginType.Mq.ToString())
        {
            var topicKey = jo.FirstOrDefault(p => p.Key.Equals("Topic", StringComparison.OrdinalIgnoreCase)).Key;
            if (topicKey is not null) jo.Remove(topicKey);
        }
        _configParam = jo.ToJsonString(JsonIndented);
        _paramJsonError = null;
    }

    /// <summary>控件文本 → JSON 值：布尔 select（「是/否」或 true/false）映射回布尔，其余走 ParseParamValue</summary>
    private static JsonNode? ParseFieldValue(ParamField f)
    {
        if (f.Cate is "select" or "radio" && IsBooleanOptions(f))
        {
            if (f.Value == f.Options[0].Key) return JsonValue.Create(true);
            if (f.Value == f.Options[1].Key) return JsonValue.Create(false);
        }
        return ParseParamValue(f.Value);
    }

    /// <summary>表单文本 → JSON 值：数字/布尔保持原类型，其余按字符串写入</summary>
    private static JsonNode? ParseParamValue(string text)
    {
        if (bool.TryParse(text, out var b)) return JsonValue.Create(b);
        if (long.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out var l)) return JsonValue.Create(l);
        if (double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var d)) return JsonValue.Create(d);
        return JsonValue.Create(text);
    }

    /// <summary>字段级校验：Pattern 正则（失败提示取插件定义的 FailTips；必填不强制，由插件自身兜底）</summary>
    private string? ValidateField(ParamField f)
    {
        if (!string.IsNullOrEmpty(f.Pattern))
        {
            try
            {
                if (!Regex.IsMatch(f.Value ?? "", f.Pattern))
                    return f.FailTips ?? T("格式有误");
            }
            catch
            {
                // 插件提供的正则不可用时不校验
            }
        }
        return null;
    }

    /// <summary>表单字段变更：即时校验 → 合并进 JSON（左侧改右侧同步）</summary>
    private void OnFieldChanged(ParamField f)
    {
        f.Error = ValidateField(f);
        SyncFormToJson();
    }

    /// <summary>JSON 输入：实时解析校验（错误立即提示位置），合法则回填表单（右侧改左侧同步）</summary>
    private void OnJsonInput(ChangeEventArgs e)
    {
        _configParam = e.Value?.ToString() ?? "";
        FromJsonToForm();
    }

    /// <summary>安全释放临时插件实例（未 On 的实例 Off 可能抛异常，Core 同路径吞掉）</summary>
    private static async Task SafeReleaseInstanceAsync(object instance)
    {
        try
        {
            switch (instance)
            {
                case IDaq d: await d.OffAsync(); break;
                case IMq m: await m.OffAsync(); break;
            }
        }
        catch { }
        try
        {
            if (instance is IAsyncDisposable ad) await ad.DisposeAsync();
        }
        catch { }
    }

    private async Task EditConfigAsync(PluginConfigModel item)
    {
        _editingConfig = item;
        _newConfigType = item.Type.ToString();
        _newConfigPluginName = item.Name;
        _configParam = FormatParam(item.Param);
        _paramTab = "form";
        _paramJsonError = null;
        _configEditing = true;
        await LoadParamDefAsync();
    }

    /// <summary>从参数 JSON 顶层读取 SN 字段（大小写不敏感）</summary>
    // ================= 组包 / WebApi 设置（对齐 WPF SettingsAutoPack/UpdateAutoPack/RemoveAutoPack + SettingsWebApi 系列） =================

    private void OpenAutoPack(PluginConfigModel item)
    {
        _autoPackConfig = item;
        _autoPackMaxByteLength = item.AutoPack?.MaxByteLength ?? 200;
        _autoPackFormat = (item.AutoPack?.Format ?? DataFormat.ABCD).ToString();
    }

    private void CloseAutoPack() => _autoPackConfig = null;

    private async Task SaveAutoPackAsync()
    {
        var item = _autoPackConfig;
        if (item is null) return;
        _autoPackConfig = null;
        if (!Enum.TryParse<DataFormat>(_autoPackFormat, out var format))
        {
            Toast.Error(T("数据字节序格式不合法"));
            return;
        }
        item.AutoPack = new AddressAutoPackModel { MaxByteLength = _autoPackMaxByteLength, Format = format };
        await SavePluginConfigFileAsync();
        Toast.Success(T("组包设置已保存"));
    }

    private async Task RemoveAutoPackAsync()
    {
        var item = _autoPackConfig;
        if (item is null) return;
        _autoPackConfig = null;
        item.AutoPack = null;
        await SavePluginConfigFileAsync();
        Toast.Success(T("组包已移除"));
    }

    private void OpenWebApi(PluginConfigModel item)
    {
        _webApiConfig = item;
        _webApiIp = item.WebApi?.IpAddress ?? "";
        _webApiPort = item.WebApi?.Port ?? 80;
        _webApiCrossDomain = item.WebApi?.CrossDomain ?? false;
    }

    private void CloseWebApi() => _webApiConfig = null;

    private async Task SaveWebApiAsync()
    {
        var item = _webApiConfig;
        if (item is null) return;
        _webApiConfig = null;
        if (string.IsNullOrWhiteSpace(_webApiIp))
        {
            Toast.Warning(T("Ip 地址不能为空"));
            return;
        }
        item.WebApi = new WAModel(_webApiIp, _webApiPort, _webApiCrossDomain);
        await SavePluginConfigFileAsync();
        Toast.Success(T("WebApi 设置已保存"));
    }

    private async Task RemoveWebApiAsync()
    {
        var item = _webApiConfig;
        if (item is null) return;
        _webApiConfig = null;
        item.WebApi = null;
        await SavePluginConfigFileAsync();
        Toast.Success(T("WebApi 已移除"));
    }

    /// <summary>落盘 PluginConfig.json（写门串行 + 重试写，供组包/WebApi 等轻量更新复用）</summary>
    private async Task SavePluginConfigFileAsync()
    {
        await AppState.ConfigSaveGate.WaitAsync();
        try
        {
            var list = new ObservableCollection<PluginConfigModel>(AppState.PluginDict.Values.OrderBy(p => p.Index));
            if (!await ProjectHandlerCore.WriteToFileWithRetryAsync(WebPaths.PluginConfigPath, list.ToJson(true)))
                Toast.Error(T("插件配置写入失败"));
        }
        finally
        {
            AppState.ConfigSaveGate.Release();
        }
    }

    /// <summary>使用检查（对齐 DAQ UseCheck）：ProjectConfig.json 全文包含 Guid 即视为被项目引用。读失败视为未使用，不阻断操作也不击穿电路</summary>
    private static bool IsConfigUsedByProject(string guid)
    {
        if (!File.Exists(WebPaths.ProjectConfigPath)) return false;
        try
        {
            return File.ReadAllText(WebPaths.ProjectConfigPath).Contains(guid);
        }
        catch
        {
            return false;
        }
    }

    /// <summary>插件配置文件名 = ConfigFormat 模板格式化 SN（对齐 WPF AddPluginConfigAsync），无模板时回退原始 SN</summary>
    private static string BuildConfigFileName(PluginListModel? plugin, string sn)
    {
        var format = plugin?.PluginDetails.ConfigFormat;
        if (string.IsNullOrWhiteSpace(format)) return sn;
        try
        {
            return string.Format(format, sn);
        }
        catch (FormatException)
        {
            // 插件清单 ConfigFormat 异常（多占位符/不配对花括号）：回退原始 SN，不让外部数据中断保存
            return sn;
        }
    }

    /// <summary>插件参数文件目录 config/{daq|mq}（对齐 WPF GlobalConfigModel.ConfigPath 布局）</summary>
    private static string TypeConfigDir(PluginType type) =>
        type == PluginType.Daq ? WebPaths.DaqPluginConfigPath : WebPaths.MqPluginConfigPath;

    private static string? ExtractSnFromParam(string param)
    {
        if (string.IsNullOrWhiteSpace(param)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(param);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return null;
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (prop.Name.Equals("SN", StringComparison.OrdinalIgnoreCase))
                    return prop.Value.ValueKind == System.Text.Json.JsonValueKind.String
                        ? prop.Value.GetString()
                        : prop.Value.ToString();
            }
        }
        catch
        {
            return null;
        }
        return null;
    }

    private static string FormatParam(string param)
    {
        if (string.IsNullOrWhiteSpace(param)) return "{}";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(param);
            // 中文不转义（与 JsonIndented 一致）
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, JsonIndented);
        }
        catch
        {
            return param;
        }
    }

    private void CloseConfigDialog() => _configEditing = false;

    private async Task SaveConfigAsync()
    {
        await OperateInfoAsync($"保存插件配置：{(_editingConfig?.SN ?? "新建配置")}");
        // 表单视图保存前先合并进 JSON（与实时同步同一路径）
        if (_paramTab == "form") SyncFormToJson();
        var param = string.IsNullOrWhiteSpace(_configParam) ? "" : _configParam;
        // JSON 语法校验：错误带行列位置，立即提示"哪里错了"
        if (!TryParseJsonObject(param, out _, out var jsonError))
        {
            _paramJsonError = jsonError;
            _paramTab = "json";
            Toast.Error($"{T("参数 JSON 错误")}：{jsonError}");
            return;
        }
        _paramJsonError = null;
        // 字段级校验（必填 / 正则），有错切到表单视图定位
        foreach (var f in _paramFields) f.Error = ValidateField(f);
        var invalid = _paramFields.FirstOrDefault(f => f.Error is not null);
        if (invalid is not null)
        {
            _paramTab = "form";
            Toast.Error($"{T("参数校验失败")}：{invalid.Description} {invalid.Error}");
            return;
        }
        var sn = ExtractSnFromParam(param);
        if (string.IsNullOrWhiteSpace(sn))
        {
            Toast.Warning(T("参数中缺少 SN，请在参数 JSON 中填写 SN"));
            return;
        }

        // 配置写门内完成：冲突检查 → per-SN 文件 → 字典 → PluginConfig.json（重试写，失败回滚内存与文件）
        PluginConfigModel? newConfig = null;
        string? newConfigFile = null;
        await AppState.ConfigSaveGate.WaitAsync();
        try
        {
            if (_editingConfig is not null)
            {
                var plugin = _plugins.FirstOrDefault(p => p.Name == _editingConfig.Name && p.Type == _editingConfig.Type);
                AppStateService.NormalizeConfigPath(_editingConfig);
                if (string.IsNullOrWhiteSpace(_editingConfig.ConfigPath))
                    _editingConfig.ConfigPath = TypeConfigDir(_editingConfig.Type);
                // 对齐 WPF UpdatePluginConfigAsync 子串替换语义（不依赖 ConfigFormat）：
                // 旧 SN 从原参数提取后在既有文件名中替换；参数中无旧 SN 时回退 ConfigFormat 模板
                var oldRawSn = ExtractSnFromParam(_editingConfig.Param);
                var oldFileName = _editingConfig.SN;
                var newFileName = !string.IsNullOrWhiteSpace(oldRawSn) && oldFileName.Contains(oldRawSn)
                    ? oldFileName.Replace(oldRawSn, sn)
                    : BuildConfigFileName(plugin, sn);
                if (AppState.PluginDict.Values.Any(p => p.Guid != _editingConfig.Guid && p.SN == newFileName))
                {
                    Toast.Error(T("SN 已存在"));
                    return;
                }
                if (!_editingConfig.Check(newFileName, oldFileName))
                {
                    Toast.Error(T("修改失败，插件配置文件名称已经存在，请修改SN"));
                    return;
                }
                var rollbackSn = _editingConfig.SN;
                var rollbackParam = _editingConfig.Param;
                var rollbackTime = _editingConfig.Time;
                _editingConfig.Param = param;
                _editingConfig.Time = DateTime.Now;
                // 先写新参数文件成功后再删旧文件（Core UpdateSnAndFileName 内部回滚）
                if (!_editingConfig.UpdateSnAndFileName(newFileName, oldFileName))
                {
                    _editingConfig.SN = rollbackSn;
                    _editingConfig.Param = rollbackParam;
                    _editingConfig.Time = rollbackTime;
                    Toast.Error(T("插件配置写入失败"));
                    return;
                }
                _editRollback = (rollbackSn, rollbackParam, rollbackTime);
            }
            else
            {
                var plugin = _plugins.FirstOrDefault(p => p.Name == _newConfigPluginName && p.Type.ToString() == _newConfigType);
                if (plugin is null)
                {
                    Toast.Warning(T("请选择插件"));
                    return;
                }
                // 对齐 WPF AddPluginConfigAsync：SN = 文件名，同步写入 per-SN 参数文件
                var configDir = TypeConfigDir(plugin.Type);
                var fileName = BuildConfigFileName(plugin, sn);
                if (File.Exists(Path.Combine(configDir, fileName)) || AppState.PluginDict.Values.Any(p => p.SN == fileName))
                {
                    Toast.Error(T("添加失败，插件配置文件已经存在"));
                    return;
                }
                var config = new PluginConfigModel
                {
                    Guid = Guid.NewGuid().ToString(),
                    Index = AppState.PluginDict.Count + 1, // 对齐 WPF：新增序号 = 当前数量 + 1
                    SN = fileName,
                    Type = plugin.Type,
                    Name = plugin.Name,
                    Param = param,
                    Time = DateTime.Now,
                    ConfigPath = configDir,
                    Status = false
                };
                if (!config.UpdateLocalConfig())
                {
                    Toast.Error(T("插件配置写入失败"));
                    return;
                }
                AppState.PluginDict[config.Guid] = config;
                newConfig = config;
                newConfigFile = Path.Combine(configDir, fileName);
            }
            var list = new ObservableCollection<PluginConfigModel>(AppState.PluginDict.Values.OrderBy(p => p.Index));
            // 重试写（对齐 ProjectConfig 落盘方式）：注意 Core 该方法失败返回 false 而不抛异常，必须检查返回值
            var saved = await ProjectHandlerCore.WriteToFileWithRetryAsync(WebPaths.PluginConfigPath, list.ToJson(true));
            if (!saved)
            {
                // 落盘失败：回滚内存与 per-SN 文件，保持内存/磁盘一致
                if (newConfig is not null)
                {
                    AppState.PluginDict.Remove(newConfig.Guid, out _);
                    if (newConfigFile is not null && File.Exists(newConfigFile))
                    {
                        try { File.Delete(newConfigFile); } catch { }
                    }
                }
                else if (_editingConfig is not null && _editRollback is { } rb)
                {
                    _editingConfig.Param = rb.Param;
                    _editingConfig.Time = rb.Time;
                    _editingConfig.UpdateSnAndFileName(rb.Sn, _editingConfig.SN);
                }
                Toast.Error(T("插件配置写入失败"));
                return;
            }
            _editRollback = null;
            // 感知更新：项目树中引用该插件配置的节点（设备 SN / MQ 传输名）同步刷新
            AppState.NotifyEntityChanged();
            Toast.Success(_editingConfig is null ? T("配置添加成功") : T("配置修改成功"));
            _configEditing = false;
            _editingConfig = null;
            // 从已装插件入口添加的配置：保存成功才切到「插件配置」展示新配置列表
            _tab = 1;
        }
        finally
        {
            AppState.ConfigSaveGate.Release();
        }
    }

    private async Task RemoveConfigAsync(PluginConfigModel item)
    {
        // 删除保护（对齐 DAQ RemovePluginConfigAsync.UseCheck）：项目配置引用了该配置则不能移除
        if (IsConfigUsedByProject(item.Guid))
        {
            Toast.Warning(T("该插件配置在项目设置中有使用"));
            return;
        }
        await OperateInfoAsync($"移除插件配置：{item.SN}");
        await AppState.ConfigSaveGate.WaitAsync();
        try
        {
            AppStateService.NormalizeConfigPath(item);
            // 对齐 WPF RemovePluginConfigAsync：连同 per-SN 参数文件一起删除
            var configDir = string.IsNullOrWhiteSpace(item.ConfigPath) ? TypeConfigDir(item.Type) : item.ConfigPath;
            var configFile = Path.Combine(configDir, item.SN);
            AppState.PluginDict.Remove(item.Guid, out _);
            var list = new ObservableCollection<PluginConfigModel>(AppState.PluginDict.Values.OrderBy(p => p.Index));
            var saved = await ProjectHandlerCore.WriteToFileWithRetryAsync(WebPaths.PluginConfigPath, list.ToJson(true));
            if (!saved)
            {
                AppState.PluginDict[item.Guid] = item; // 回滚内存
                Toast.Error(T("插件配置写入失败"));
                return;
            }
            // JSON 落盘成功后再删参数文件
            if (File.Exists(configFile)) File.Delete(configFile);
            // 感知更新：树中 MQ 传输节点保持引用但名称不再变化；设备节点引用移除后不复活（Refresh 不塞回）
            AppState.NotifyEntityChanged();
            Toast.Success(T("配置已移除"));
        }
        finally
        {
            AppState.ConfigSaveGate.Release();
        }
    }

    private async Task OpenDaqTest(PluginConfigModel item, string mode)
    {
        _daqTestConfig = item;
        _daqTestMode = mode;
        _daqTestAddress = "";
        _daqTestValue = "";
        _daqTestRunning = false;
        // 协议类型：从插件参数的自动分配属性读取当前协议值；插件无协议字段时留空（弹窗不显示该行）
        _daqTestProtocol = "";
        try
        {
            var (propName, _) = await GetAutoSubsetAsync(item.Name, item.Type, item.Param);
            if (!string.IsNullOrEmpty(propName) && !string.IsNullOrWhiteSpace(item.Param))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(item.Param);
                if (doc.RootElement.TryGetProperty(propName, out var p)
                    && p.ValueKind == System.Text.Json.JsonValueKind.String)
                    _daqTestProtocol = p.GetString() ?? "";
            }
        }
        catch
        {
            _daqTestProtocol = "";
        }
    }

    private void CloseDaqTest() => _daqTestConfig = null;

    private async Task RunDaqTestAsync()
    {
        var item = _daqTestConfig;
        if (item is null) return;
        if (string.IsNullOrWhiteSpace(_daqTestAddress))
        {
            Toast.Warning(T("地址不能为空"));
            return;
        }
        if (_daqTestMode == "write" && string.IsNullOrWhiteSpace(_daqTestValue))
        {
            Toast.Warning(T("值不能为空"));
            return;
        }
        _daqTestRunning = true;
        try
        {
            var model = new AddressModelCore
            {
                Address = _daqTestAddress,
                Type = _daqTestType,
                Length = _daqTestLength,
                EncodingType = _daqTestEncoding
            };
            if (_daqTestMode == "read")
            {
                var r = await model.TestReadAddressAsync(item);
                CloseDaqTest();
                ShowTestResult(r);
                if (r.Status) Toast.Success($"{T("读取成功")}: {r.Message}");
                else Toast.Error($"{T("读取失败")}: {r.Message}");
            }
            else
            {
                var write = new DaqPluginOperateModel.WriteModel
                {
                    Address = _daqTestAddress,
                    Value = ParseWriteValue(_daqTestValue, _daqTestType),
                    AddressDataType = _daqTestType,
                    EncodingType = _daqTestEncoding
                };
                var r = await model.TestWriteAddressAsync(item, write);
                CloseDaqTest();
                ShowTestResult(r);
                if (r.Status) Toast.Success($"{T("写入成功")}: {r.Message}");
                else Toast.Error($"{T("写入失败")}: {r.Message}");
            }
        }
        catch (Exception ex)
        {
            CloseDaqTest();
            _testResult = new TestResult(false, ex.Message, null);
            Toast.Error($"{T("测试失败")}: {ex.Message}");
        }
        finally
        {
            _daqTestRunning = false;
        }
    }

    /// <summary>按地址数据类型把用户输入字符串转换为对应 CLR 类型（失败回退字符串）</summary>
    private static object ParseWriteValue(string s, DataType t)
    {
        try
        {
            var dotnetType = t switch
            {
                DataType.Byte => typeof(byte),
                DataType.Short or DataType.Int16 => typeof(short),
                DataType.Ushort or DataType.UInt16 => typeof(ushort),
                DataType.Int or DataType.Int32 => typeof(int),
                DataType.Uint or DataType.UInt32 => typeof(uint),
                DataType.Long or DataType.Int64 => typeof(long),
                DataType.Ulong or DataType.UInt64 => typeof(ulong),
                DataType.Float or DataType.Single => typeof(float),
                DataType.Double => typeof(double),
                DataType.Bool => typeof(bool),
                _ => null
            };
            if (dotnetType is not null) return Convert.ChangeType(s, dotnetType);
        }
        catch { }
        return s;
    }

    private void OpenMqTest(PluginConfigModel item)

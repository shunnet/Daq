@namespace Snet.Iot.Daq.Web.Components.Shared

<div class="log-view" @ref="_element" @onscroll="OnScroll">
    @foreach (var line in Lines.TakeLast(MaxLines))
    {
        <div class="@Classify(line)">@line</div>
    }
</div>

@inject IJSRuntime JS
@code {
    [Parameter] public List<string> Lines { get; set; } = new();
    [Parameter] public int MaxLines { get; set; } = 2000;

    private ElementReference _element;
    private List<string>? _renderedLines;

    /// <summary>日志文本不随语言变化：仅当日志快照引用变化时才重渲染，隔离语言切换/父组件无关重渲染
    /// （2000 条日志全量渲染是页面最大开销，父组件每次 StateHasChanged 都会级联触发，ShouldRender 拦截后大幅提速）</summary>
    protected override bool ShouldRender() => !ReferenceEquals(_renderedLines, Lines);

    protected override void OnAfterRender(bool firstRender) => _renderedLines = Lines;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 新日志到达时自动滚到底部（默认跟随最新消息；用户上滚回溯时暂停跟随，回到底部恢复）
        if (firstRender)
            await JS.InvokeVoidAsync("snet.logScroll.init");
        await JS.InvokeVoidAsync("snet.logScroll.stick", _element);
    }

    private async Task OnScroll()
    {
        await JS.InvokeVoidAsync("snet.logScroll.onScroll", _element);
    }

    /// <summary>日志着色规则（与 WPF TextEditorControl 对齐）：[Info]→绿 / Error→红 / Mq·Daq·Service→蓝 / TRUE→绿 / FALSE→红</summary>
    private static string Classify(string line)
    {
        if (line.Contains("[Info]", StringComparison.OrdinalIgnoreCase)) return "info";
        if (line.Contains("Error", StringComparison.OrdinalIgnoreCase)
            || line.Contains("Exception", StringComparison.OrdinalIgnoreCase)
            || line.Contains("失败", StringComparison.Ordinal)) return "error";
        if (line.Contains("[Mq", StringComparison.OrdinalIgnoreCase)
            || line.Contains("[Daq", StringComparison.OrdinalIgnoreCase)
            || line.Contains("Service", StringComparison.OrdinalIgnoreCase)) return "mq";
        if (line.Contains("TRUE", StringComparison.OrdinalIgnoreCase)) return "info";
        if (line.Contains("FALSE", StringComparison.OrdinalIgnoreCase)) return "error";
        if (line.Contains(">", StringComparison.Ordinal) || line.Contains("<", StringComparison.Ordinal)) return "warn";
        return "";
    }
}

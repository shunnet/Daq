@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="modal-overlay">
    <div class="modal" role="alertdialog" aria-modal="true" aria-label="@Title" tabindex="-1" @ref="_dialog" @onkeydown="OnKeyDown">
        <div class="modal-header">
            <span class="modal-title-text">
                <span class="modal-title-icon modal-title-icon-warning"><i class="bi bi-question-circle"></i></span>
                @Title
            </span>
            <button class="btn btn-icon modal-close" @onclick="Cancel" aria-label="close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <p class="confirm-message">@Message</p>
        </div>
        <div class="modal-footer">
            <button class="btn" @onclick="Cancel"><i class="bi bi-x-lg"></i>@CancelText</button>
            <button class="btn btn-danger" @onclick="Confirm"><i class="bi bi-trash"></i>@ConfirmText</button>
        </div>
    </div>
</div>

@code {
    private ElementReference _dialog;
    private string? _focusId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _focusId = await JS.InvokeAsync<string>("snet.modalFocus.open", _dialog);
    }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Cancel() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try { if (_focusId is not null) await JS.InvokeVoidAsync("snet.modalFocus.close", _focusId); }
        catch (JSDisconnectedException) { }
    }

    [Parameter] public string Title { get; set; } = "确认";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string CancelText { get; set; } = "取消";
    [Parameter] public string ConfirmText { get; set; } = "确认";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private Task Cancel() => OnCancel.InvokeAsync();
    private Task Confirm() => OnConfirm.InvokeAsync();
}

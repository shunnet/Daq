<div class="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal-header">
            <span class="modal-title-text">
                @if (!string.IsNullOrEmpty(TitleIcon))
                {
                    <i class="bi @TitleIcon"></i>
                }
                @Title
            </span>
            <button class="btn btn-icon" @onclick="Close" aria-label="close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="modal-body">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="modal-footer">
                @Footer
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    /// <summary>标题左侧图标（bootstrap icons 类名，如 bi-plus-circle），空则无图标</summary>
    [Parameter] public string? TitleIcon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
